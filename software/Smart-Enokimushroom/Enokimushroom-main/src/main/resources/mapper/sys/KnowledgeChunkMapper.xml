<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.enokimushroom.mapper.KnowledgeChunkMapper">
    
    <resultMap type="com.enokimushroom.entity.KnowledgeChunk" id="KnowledgeChunkResult">
        <result property="id"           column="id"           />
        <result property="kbId"         column="kb_id"        />
        <result property="chunkIndex"   column="chunk_index"  />
        <result property="content"      column="content"      />
        <result property="createTime"   column="create_time"  />
    </resultMap>
    
    <sql id="selectKnowledgeChunkVo">
        select id, kb_id, chunk_index, content, create_time from knowledge_chunk
    </sql>
    
    <select id="selectList" resultMap="KnowledgeChunkResult">
        <include refid="selectKnowledgeChunkVo"/>
        <where>
            <if test="ew != null and ew.sqlSegment != null and ew.sqlSegment != ''">
                ${ew.sqlSegment}
            </if>
        </where>
        order by chunk_index asc
    </select>
    
    <select id="selectPage" resultMap="KnowledgeChunkResult">
        <include refid="selectKnowledgeChunkVo"/>
        <where>
            <if test="ew != null and ew.sqlSegment != null and ew.sqlSegment != ''">
                ${ew.sqlSegment}
            </if>
        </where>
        order by chunk_index asc
    </select>
    
    <select id="selectById" parameterType="Long" resultMap="KnowledgeChunkResult">
        <include refid="selectKnowledgeChunkVo"/>
        where id = #{id}
    </select>
    
    <select id="selectByKbId" parameterType="Long" resultMap="KnowledgeChunkResult">
        <include refid="selectKnowledgeChunkVo"/>
        where kb_id = #{kbId}
        order by chunk_index asc
    </select>
    
    <insert id="insert" parameterType="com.enokimushroom.entity.KnowledgeChunk" useGeneratedKeys="true" keyProperty="id">
        insert into knowledge_chunk (
            kb_id, chunk_index, content, create_time
        ) values (
            #{kbId}, #{chunkIndex}, #{content}, #{createTime}
        )
    </insert>
    
    <insert id="insertBatch" parameterType="java.util.List">
        insert into knowledge_chunk (kb_id, chunk_index, content, create_time) values
        <foreach collection="list" item="item" separator=",">
            (#{item.kbId}, #{item.chunkIndex}, #{item.content}, #{item.createTime})
        </foreach>
    </insert>
    
    <update id="updateById" parameterType="com.enokimushroom.entity.KnowledgeChunk">
        update knowledge_chunk
        <set>
            <if test="chunkIndex != null">chunk_index = #{chunkIndex},</if>
            <if test="content != null">content = #{content},</if>
        </set>
        where id = #{id}
    </update>
    
    <delete id="deleteById" parameterType="Long">
        delete from knowledge_chunk where id = #{id}
    </delete>
    
    <delete id="deleteByKbId" parameterType="Long">
        delete from knowledge_chunk where kb_id = #{kbId}
    </delete>
    
    <delete id="deleteBatchIds" parameterType="java.util.List">
        delete from knowledge_chunk where id in
        <foreach collection="list" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    
</mapper>
