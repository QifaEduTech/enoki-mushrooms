<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.enokimushroom.mapper.KnowledgeBaseMapper">
    
    <resultMap type="com.enokimushroom.entity.KnowledgeBase" id="KnowledgeBaseResult">
        <result property="id"           column="id"           />
        <result property="name"         column="name"         />
        <result property="remark"       column="remark"       />
        <result property="fileName"     column="file_name"    />
        <result property="userId"       column="user_id"      />
        <result property="uploadTime"   column="upload_time"  />
        <result property="status"       column="status"       />
        <result property="topK"         column="top_k"        />
    </resultMap>
    
    <sql id="selectKnowledgeBaseVo">
        select id, name, remark, file_name, user_id, upload_time, status, top_k from knowledge_base
    </sql>
    
    <select id="selectList" resultMap="KnowledgeBaseResult">
        <include refid="selectKnowledgeBaseVo"/>
        <where>
            <if test="ew != null and ew.sqlSegment != null and ew.sqlSegment != ''">
                ${ew.sqlSegment}
            </if>
        </where>
        order by upload_time desc
    </select>
    
    <select id="selectPage" resultMap="KnowledgeBaseResult">
        <include refid="selectKnowledgeBaseVo"/>
        <where>
            <if test="ew != null and ew.sqlSegment != null and ew.sqlSegment != ''">
                ${ew.sqlSegment}
            </if>
        </where>
        order by upload_time desc
    </select>
    
    <select id="selectById" parameterType="Long" resultMap="KnowledgeBaseResult">
        <include refid="selectKnowledgeBaseVo"/>
        where id = #{id}
    </select>
    
    <insert id="insert" parameterType="com.enokimushroom.entity.KnowledgeBase" useGeneratedKeys="true" keyProperty="id">
        insert into knowledge_base (
            name, remark, file_name, user_id, upload_time, status, top_k
        ) values (
            #{name}, #{remark}, #{fileName}, #{userId}, #{uploadTime}, #{status}, #{topK}
        )
    </insert>
    
    <update id="updateById" parameterType="com.enokimushroom.entity.KnowledgeBase">
        update knowledge_base
        <set>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="fileName != null">file_name = #{fileName},</if>
            <if test="status != null">status = #{status},</if>
            <if test="topK != null">top_k = #{topK},</if>
        </set>
        where id = #{id}
    </update>
    
    <delete id="deleteById" parameterType="Long">
        delete from knowledge_base where id = #{id}
    </delete>
    
    <delete id="deleteBatchIds" parameterType="java.util.List">
        delete from knowledge_base where id in
        <foreach collection="list" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    
</mapper>
