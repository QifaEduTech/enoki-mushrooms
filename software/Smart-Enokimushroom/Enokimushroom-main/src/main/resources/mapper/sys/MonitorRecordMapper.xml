            <if test="delFlag != null">#{delFlag},</if>
         </trim>
    </insert>

    <update id="updateMonitorRecord" parameterType="MonitorRecord">
        update monitor_record
        <trim prefix="SET" suffixOverrides=",">
            <if test="airTemperature != null">air_temperature = #{airTemperature},</if>
            <if test="airHumidity != null">air_humidity = #{airHumidity},</if>
            <if test="lightLux != null">light_lux = #{lightLux},</if>
            <if test="airCo2 != null">air_co2 = #{airCo2},</if>
            <if test="soilTemperature != null">soil_temperature = #{soilTemperature},</if>
            <if test="soilHumidity != null">soil_humidity = #{soilHumidity},</if>
            <if test="soilConductivity != null">soil_conductivity = #{soilConductivity},</if>
            <if test="soilPh != null">soil_PH = #{soilPh},</if>
            <if test="soilN != null">soil_N = #{soilN},</if>
            <if test="soilP != null">soil_P = #{soilP},</if>
            <if test="soilK != null">soil_K = #{soilK},</if>
            <if test="createDate != null">create_date = #{createDate},</if>
            <if test="plantId != null">plant_id = #{plantId},</if>
            <if test="areaId != null">area_id = #{areaId},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="updateDate != null">update_date = #{updateDate},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
        </trim>
        where record_id = #{recordId}
    </update>

    <delete id="deleteMonitorRecordByRecordId" parameterType="Long">
        delete from monitor_record where record_id = #{recordId} and del_flag =0
    </delete>

    <delete id="deleteMonitorRecordByRecordIds" parameterType="String">
        update monitor_record set del_flag=1 where record_id in
