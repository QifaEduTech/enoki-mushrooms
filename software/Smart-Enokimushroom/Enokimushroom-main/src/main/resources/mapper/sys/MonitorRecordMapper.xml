    <select id="selectMonitorRecordList" parameterType="MonitorRecord" resultMap="MonitorRecordResult">
        select mr.address_id,mr.record_id, mr.air_temperature, mr.air_humidity, mr.light_lux, mr.air_co2, mr.soil_temperature, mr.soil_humidity, mr.soil_conductivity,
        mr.soil_PH, mr.soil_N, mr.soil_P, mr.soil_K, mr.create_date, mr.plant_id, mr.area_id, mr.create_by, mr.update_date, mr.update_by, mr.del_flag,
        am.area_name,pm.plant_name from monitor_record mr
        left join  area_manage am on am.area_id = mr.area_id
        left join plant_manage pm on pm.plant_id = mr.plant_id
        <where>
            <if test="airTemperature != null "> and mr.air_temperature = #{airTemperature}</if>
            <if test="airHumidity != null "> and mr.air_humidity = #{airHumidity}</if>
            <if test="lightLux != null "> and mr.light_lux = #{lightLux}</if>
            <if test="airCo2 != null "> and mr.air_co2 = #{airCo2}</if>
            <if test="soilTemperature != null "> and mr.soil_temperature = #{soilTemperature}</if>
            <if test="soilHumidity != null "> and mr.soil_humidity = #{soilHumidity}</if>
            <if test="soilConductivity != null "> and mr.soil_conductivity = #{soilConductivity}</if>
            <if test="soilPh != null "> and mr.soil_PH = #{soilPh}</if>
            <if test="soilN != null "> and mr.soil_N = #{soilN}</if>
            <if test="soilP != null "> and mr.soil_P = #{soilP}</if>
            <if test="soilK != null "> and mr.soil_K = #{soilK}</if>
            <if test="startCreateDate != null and stopCreateDate != null"> and mr.create_date between #{startCreateDate} and #{stopCreateDate}</if>
            <if test="plantId != null "> and mr.plant_id = #{plantId}</if>
            <if test="areaId != null "> and mr.area_id = #{areaId}</if>
            <if test="updateDate != null "> and mr.update_date = #{updateDate}</if>
            <if test="delFlag = null or delFlag = ''" > and mr.del_flag =0 </if>
            <if test="userId != null and userId != 1 "> and mr.user_id = #{userId}</if>
            <if test="addressId != null and addressId != 1 "> and mr.address_id = #{addressId}</if>
        </where>
        order by mr.create_date DESC, mr.record_id DESC
    </select>
    
    <select id="selectMonitorRecordByRecordId" parameterType="Long" resultMap="MonitorRecordResult">
        <include refid="selectMonitorRecordVo"/>
        where record_id = #{recordId} and del_flag =0
    </select>

    <insert id="insertMonitorRecord" parameterType="MonitorRecord" useGeneratedKeys="true" keyProperty="recordId">
        insert into monitor_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="addressId != null">address_id,</if>
            <if test="userId != null">user_id,</if>
            <if test="airTemperature != null">air_temperature,</if>
            <if test="airHumidity != null">air_humidity,</if>
            <if test="lightLux != null">light_lux,</if>
            <if test="airCo2 != null">air_co2,</if>
            <if test="soilTemperature != null">soil_temperature,</if>
            <if test="soilHumidity != null">soil_humidity,</if>
            <if test="soilConductivity != null">soil_conductivity,</if>
            <if test="soilPh != null">soil_PH,</if>
            <if test="soilN != null">soil_N,</if>
            <if test="soilP != null">soil_P,</if>
            <if test="soilK != null">soil_K,</if>
            <if test="createDate == null">create_date,</if>
            <if test="plantId != null">plant_id,</if>
            <if test="areaId != null">area_id,</if>
            <if test="createBy != null">create_by,</if>
            <if test="updateDate != null">update_date,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="delFlag != null">del_flag,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="addressId != null">#{addressId},</if>
            <if test="userId != null">#{userId},</if>
            <if test="airTemperature != null">#{airTemperature},</if>
            <if test="airHumidity != null">#{airHumidity},</if>
            <if test="lightLux != null">#{lightLux},</if>
            <if test="airCo2 != null">#{airCo2},</if>
            <if test="soilTemperature != null">#{soilTemperature},</if>
            <if test="soilHumidity != null">#{soilHumidity},</if>
            <if test="soilConductivity != null">#{soilConductivity},</if>
            <if test="soilPh != null">#{soilPh},</if>
            <if test="soilN != null">#{soilN},</if>
            <if test="soilP != null">#{soilP},</if>
            <if test="soilK != null">#{soilK},</if>
            <if test="createDate == null">NOW(),</if>
            <if test="plantId != null">#{plantId},</if>
            <if test="areaId != null">#{areaId},</if>
            <if test="createBy != null">#{createBy},</if>
